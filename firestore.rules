rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membership(academyId) {
      return get(/databases/$(database)/documents/academies/$(academyId)/members/$(request.auth.uid));
    }

    function belongsToAcademy(academyId) {
      return signedIn() && request.auth.token.get('passwordChangeRequired', false) != true && membership(academyId).data.active == true;
    }

    function isAdmin(academyId) {
      return belongsToAcademy(academyId) && membership(academyId).data.role == 'admin';
    }

    function isTeacher(academyId) {
      return belongsToAcademy(academyId) && membership(academyId).data.role == 'teacher';
    }

    function isStudent(academyId) {
      return belongsToAcademy(academyId) && membership(academyId).data.role == 'student';
    }

    function isStudentInGoodFinancialStanding(academyId) {
      let studentPath = /databases/$(database)/documents/academies/$(academyId)/students/$(request.auth.uid);
      return isStudent(academyId) &&
        membership(academyId).data.get('accessBlocked', false) != true &&
        exists(studentPath) && get(studentPath).data.get('accessBlocked', false) != true;
    }

    function isNextStudentRank(currentRank, nextRank) {
      return (currentRank == 'Bronze' && nextRank == 'Prata') ||
        (currentRank == 'Prata' && nextRank == 'Ouro') ||
        (currentRank == 'Ouro' && nextRank == 'Diamante');
    }

    function isDeveloper() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'developer';
    }

    function canUpdateAcademy(academyId) {
      return (isDeveloper() || (isAdmin(academyId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'phone', 'instagramUrl', 'siteUrl', 'whatsappUrl', 'whatsappGroupUrl',
          'openingDays', 'openingTime', 'closingTime', 'updatedAt', 'updatedBy'
        ]))) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'aiCredits', 'aiCreditsBalance', 'aiCreditsMonthly', 'aiCreditsExtras',
          'aiCreditsTotal', 'aiCreditsUsed', 'aiCreditsLastReason',
          'aiCreditsUpdatedAt', 'aiCreditsUpdatedBy'
        ]);
    }

    function isOnboardingOwner(academyId) {
      return signedIn() &&
        getAfter(/databases/$(database)/documents/academies/$(academyId)).data.ownerId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/academies/$(academyId)/members/$(request.auth.uid)).data.role == 'admin' &&
        getAfter(/databases/$(database)/documents/academies/$(academyId)/members/$(request.auth.uid)).data.active == true;
    }

    function validInvitation(codeId, academyId, role) {
      return signedIn() &&
        get(/databases/$(database)/documents/accessCodes/$(codeId)).data.active == true &&
        get(/databases/$(database)/documents/accessCodes/$(codeId)).data.academyId == academyId &&
        get(/databases/$(database)/documents/accessCodes/$(codeId)).data.role == role &&
        (get(/databases/$(database)/documents/accessCodes/$(codeId)).data.get('invitedEmail', null) == null ||
          get(/databases/$(database)/documents/accessCodes/$(codeId)).data.get('invitedEmail', null) == request.auth.token.email) &&
        getAfter(/databases/$(database)/documents/accessCodes/$(codeId)).data.active == false &&
        getAfter(/databases/$(database)/documents/accessCodes/$(codeId)).data.claimedBy == request.auth.uid;
    }

    function validWeeklyLimit(data) {
      return data.get('weeklyVisitLimit', null) == null ||
        (data.weeklyVisitLimit is int && data.weeklyVisitLimit >= 1 && data.weeklyVisitLimit <= 7);
    }

    function invitedStudentData() {
      let invitation = get(/databases/$(database)/documents/accessCodes/$(request.resource.data.activationCodeId)).data;
      return request.resource.data.get('planId', null) == invitation.get('planId', null) &&
        request.resource.data.get('planPrice', null) == invitation.get('planPrice', null) &&
        request.resource.data.get('plan', null) == invitation.get('plan', null) &&
        request.resource.data.get('planInterval', null) == invitation.get('planInterval', null) &&
        request.resource.data.get('weeklyVisitLimit', null) == invitation.get('weeklyVisitLimit', null) &&
        request.resource.data.get('registrationFee', 0) == invitation.get('registrationFee', 0) &&
        request.resource.data.get('approvedRank', 'Bronze') == 'Bronze' &&
        request.resource.data.active == true && request.resource.data.accessBlocked == false;
    }

    match /accessCodes/{codeId} {
      // O código é um segredo de uso único: permite leitura apenas por ID,
      // e nunca enumeração da coleção. Convites vinculados a e-mail só podem
      // ser consultados pela conta convidada.
      allow get: if signedIn() && resource.data.active == true &&
        (resource.data.get('invitedEmail', null) == null ||
          resource.data.get('invitedEmail', null) == request.auth.token.email);
      allow list: if false;
      allow create: if signedIn() && isAdmin(request.resource.data.academyId) &&
        request.resource.data.active == true &&
        request.resource.data.role in ['admin', 'teacher', 'student'] &&
        (request.resource.data.role != 'admin' || isDeveloper()) &&
        (request.resource.data.role != 'admin' || request.resource.data.invitedEmail is string);
      allow update: if signedIn() && resource.data.active == true &&
        (resource.data.get('invitedEmail', null) == null || resource.data.invitedEmail == request.auth.token.email) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'claimedBy', 'claimedAt']) &&
        request.resource.data.active == false &&
        request.resource.data.claimedBy == request.auth.uid &&
        request.resource.data.academyId == resource.data.academyId &&
        request.resource.data.role == resource.data.role;
      allow delete: if isAdmin(resource.data.academyId);
    }

    match /users/{userId} {
      allow read: if isDeveloper() || (signedIn() && request.auth.uid == userId);
      allow create: if signedIn() && request.auth.uid == userId &&
        request.resource.data.get('accountType', 'academy_admin') == 'academy_admin' &&
        ((request.resource.data.activeAcademyId is string && isOnboardingOwner(request.resource.data.activeAcademyId)) ||
          (request.resource.data.activationCodeId is string && request.resource.data.activeAcademyId is string &&
            validInvitation(request.resource.data.activationCodeId, request.resource.data.activeAcademyId,
              get(/databases/$(database)/documents/accessCodes/$(request.resource.data.activationCodeId)).data.role)));
      allow update: if signedIn() && request.auth.uid == userId &&
        (request.resource.data.get('accountType', null) == resource.data.get('accountType', null) ||
          (resource.data.get('accountType', null) != 'developer' && request.resource.data.get('accountType', null) == 'academy_admin')) &&
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'name', 'photoUrl', 'phone', 'cpf', 'cnpj', 'businessName', 'cep', 'street', 'number', 'complement', 'district', 'city', 'state', 'instagramUrl', 'siteUrl', 'whatsappUrl', 'whatsappGroupUrl', 'updatedAt', 'lastAccessAt', 'lastSeenAt', 'lastRole', 'activeAcademyId', 'presenceStatus', 'presenceEnteredAt', 'presenceExitedAt']) &&
          (!request.resource.data.keys().hasAny(['photoUrl']) ||
            (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() < 200000)) ||
          (request.resource.data.activeAcademyId is string && isOnboardingOwner(request.resource.data.activeAcademyId)) ||
          (request.resource.data.activationCodeId is string && request.resource.data.activeAcademyId is string &&
            validInvitation(request.resource.data.activationCodeId, request.resource.data.activeAcademyId,
              get(/databases/$(database)/documents/accessCodes/$(request.resource.data.activationCodeId)).data.role)));
      allow delete: if false;
    }

    match /academies/{academyId} {
      allow create: if isDeveloper() && request.resource.data.ownerId == request.auth.uid;
      allow read: if isDeveloper() || belongsToAcademy(academyId);
      // Saldo e bônus de IA só podem ser alterados pela callable addAiCredits,
      // que valida o administrador da plataforma e grava o histórico.
      allow update: if canUpdateAcademy(academyId);
      allow delete: if false;
    }

    match /academies/{academyId}/members/{memberId} {
      allow read: if isDeveloper() || (signedIn() && (memberId == request.auth.uid || isAdmin(academyId)));
      allow create: if signedIn() && (
        (memberId == request.auth.uid &&
          request.resource.data.role == 'admin' &&
          request.resource.data.active == true &&
          getAfter(/databases/$(database)/documents/academies/$(academyId)).data.ownerId == request.auth.uid) ||
        isAdmin(academyId) ||
        (memberId == request.auth.uid && request.resource.data.userId == request.auth.uid &&
          request.resource.data.active == true &&
          request.resource.data.keys().hasOnly(['userId', 'displayName', 'email', 'username', 'role', 'active', 'activationCodeId', 'createdAt']) &&
          validInvitation(request.resource.data.activationCodeId, academyId, request.resource.data.role))
      );
      allow update: if isDeveloper() || isAdmin(academyId) ||
        (memberId == request.auth.uid && request.resource.data.role == 'admin' &&
          request.resource.data.active == true && isOnboardingOwner(academyId)) ||
        (memberId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastAccessAt', 'lastSeenAt', 'lastRole', 'presenceStatus', 'presenceEnteredAt', 'presenceExitedAt']));
      allow delete: if isAdmin(academyId);
    }

    match /academies/{academyId}/students/{studentId} {
      allow read: if isAdmin(academyId) ||
        isTeacher(academyId) ||
        (isStudent(academyId) && studentId == request.auth.uid);
      allow create: if isAdmin(academyId) || isTeacher(academyId) ||
        (studentId == request.auth.uid &&
          request.resource.data.activationCodeId is string &&
          validInvitation(request.resource.data.activationCodeId, academyId, 'student') && invitedStudentData());
      allow update: if isAdmin(academyId) ||
        (isTeacher(academyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvedRank', 'rankApprovedAt', 'rankApprovedBy']) &&
          request.resource.data.get('approvedRank', null) in ['Bronze', 'Prata', 'Ouro', 'Diamante'] &&
          request.resource.data.get('rankApprovedAt', null) is timestamp &&
          request.resource.data.get('rankApprovedBy', null) == request.auth.uid &&
          isNextStudentRank(resource.data.get('approvedRank', 'Bronze'), request.resource.data.get('approvedRank', null)));
      allow delete: if isAdmin(academyId);
    }

    match /academies/{academyId}/teachers/{teacherId} {
      allow read: if isAdmin(academyId) || (isTeacher(academyId) && teacherId == request.auth.uid);
      allow create: if isAdmin(academyId) ||
        (teacherId == request.auth.uid &&
          request.resource.data.activationCodeId is string &&
          validInvitation(request.resource.data.activationCodeId, academyId, 'teacher'));
      allow update: if isAdmin(academyId);
      allow delete: if isAdmin(academyId);
    }

    match /academies/{academyId}/plans/{planId} {
      allow read: if isAdmin(academyId);
      allow create, update: if isAdmin(academyId) && validWeeklyLimit(request.resource.data);
      allow delete: if false;
    }

    match /academies/{academyId}/monthlyCharges/{chargeId} {
      allow read: if isAdmin(academyId) ||
        (isStudent(academyId) && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin(academyId);
      allow update: if isAdmin(academyId) ||
        (isStudent(academyId) &&
          resource.data.accessCodeId is string &&
          resource.data.studentId == resource.data.accessCodeId &&
          resource.data.accessCodeId == membership(academyId).data.activationCodeId &&
          request.resource.data.studentId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentId', 'studentName', 'updatedAt']));
      allow delete: if false;
    }

    match /academies/{academyId}/exercises/{exerciseId} {
      allow read: if isAdmin(academyId) || isTeacher(academyId) || isStudentInGoodFinancialStanding(academyId);
      allow create, update: if isAdmin(academyId) || isTeacher(academyId);
      allow delete: if isAdmin(academyId);
    }

    match /academies/{academyId}/workouts/{workoutId} {
      allow read: if isAdmin(academyId) || isTeacher(academyId) ||
        (isStudentInGoodFinancialStanding(academyId) && (resource.data.studentId == request.auth.uid ||
          resource.data.studentUserId == request.auth.uid));
      allow create, update: if isAdmin(academyId) || isTeacher(academyId);
      allow delete: if isAdmin(academyId) || isTeacher(academyId);
    }

    match /academies/{academyId}/workoutTemplates/{templateId} {
      allow read: if isAdmin(academyId) || isTeacher(academyId) ||
        (isStudentInGoodFinancialStanding(academyId) && (resource.data.audience == "Geral" ||
          resource.data.targetStudentId == request.auth.uid));
      allow create, update: if isAdmin(academyId) || isTeacher(academyId);
      allow delete: if isAdmin(academyId) || isTeacher(academyId);
    }

    match /academies/{academyId}/workoutExecutions/{executionId} {
      allow read: if isAdmin(academyId) || isTeacher(academyId) ||
        (isStudentInGoodFinancialStanding(academyId) && resource.data.studentId == request.auth.uid);
      allow create: if isStudentInGoodFinancialStanding(academyId) && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if false;
    }

    match /academies/{academyId}/classes/{classId} {
      allow read: if isAdmin(academyId) || isTeacher(academyId) || isStudentInGoodFinancialStanding(academyId);
      allow create, update: if isAdmin(academyId) || isTeacher(academyId);
      allow delete: if isAdmin(academyId);
    }

    match /academies/{academyId}/reservations/{reservationId} {
      allow read: if isAdmin(academyId) || isTeacher(academyId) ||
        (isStudentInGoodFinancialStanding(academyId) && resource.data.studentId == request.auth.uid);
      // Reservas de alunos passam pela callable reserveClass/cancelClassReservation,
      // que valida lotação e atualiza o contador da turma em uma transação.
      allow create, update: if isAdmin(academyId) || isTeacher(academyId);
      allow delete: if isAdmin(academyId);
    }

    match /academies/{academyId}/classWaitlist/{waitlistId} {
      allow read: if isAdmin(academyId) || isTeacher(academyId) ||
        (isStudentInGoodFinancialStanding(academyId) && resource.data.studentId == request.auth.uid);
      // A entrada e a promoção são feitas pelas callables, com validação de lotação.
      allow create, update: if isAdmin(academyId) || isTeacher(academyId);
      allow delete: if isAdmin(academyId);
    }

    match /academies/{academyId}/attendance/{attendanceId} {
      allow read: if isAdmin(academyId) || isTeacher(academyId) ||
        (isStudentInGoodFinancialStanding(academyId) && resource.data.studentId == request.auth.uid);
      allow create: if isStudentInGoodFinancialStanding(academyId) && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if false;
    }

    match /academies/{academyId}/assessments/{assessmentId} {
      allow read: if isAdmin(academyId) || isTeacher(academyId) ||
        (isStudent(academyId) && resource.data.studentId == request.auth.uid);
      allow create, update: if isAdmin(academyId) || isTeacher(academyId);
      allow delete: if isAdmin(academyId);
    }

    match /academies/{academyId}/messages/{messageId} {
      allow read: if isAdmin(academyId) ||
        (isTeacher(academyId) && get(/databases/$(database)/documents/academies/$(academyId)/students/$(resource.data.studentId)).data.teacherId == request.auth.uid) ||
        (isStudent(academyId) && resource.data.studentId == request.auth.uid);
      allow create: if isAdmin(academyId) ||
        (isTeacher(academyId) && request.resource.data.senderId == request.auth.uid &&
          get(/databases/$(database)/documents/academies/$(academyId)/students/$(request.resource.data.studentId)).data.teacherId == request.auth.uid);
      allow update: if isAdmin(academyId) ||
        (isStudent(academyId) && resource.data.studentId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isAdmin(academyId);
    }

    match /academies/{academyId}/scheduledMessages/{messageId} {
      allow read: if isAdmin(academyId);
      allow create: if isAdmin(academyId) &&
        request.resource.data.studentId is string &&
        request.resource.data.phone is string &&
        request.resource.data.body is string &&
        request.resource.data.scheduledAt is string &&
        request.resource.data.status == 'pending';
      allow update: if isAdmin(academyId);
      allow delete: if isAdmin(academyId);
    }

    match /academies/{academyId}/announcements/{announcementId} {
      allow read: if belongsToAcademy(academyId);
      allow create, update: if isAdmin(academyId);
      allow delete: if isAdmin(academyId);
    }

    match /academies/{academyId}/workoutFeedback/{feedbackId} {
      allow read: if isAdmin(academyId) || isTeacher(academyId) ||
        (isStudentInGoodFinancialStanding(academyId) && resource.data.studentId == request.auth.uid);
      allow create: if isStudentInGoodFinancialStanding(academyId) &&
        request.resource.data.studentId == request.auth.uid &&
        request.resource.data.workoutId is string &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() <= 800;
      allow update: if isStudentInGoodFinancialStanding(academyId) &&
        resource.data.studentId == request.auth.uid &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'comment', 'updatedAt']) &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() <= 800;
      allow delete: if isAdmin(academyId);
    }

    match /academies/{academyId}/notificationReads/{readId} {
      allow read: if belongsToAcademy(academyId) && resource.data.userId == request.auth.uid;
      allow create, update: if belongsToAcademy(academyId) && request.resource.data.userId == request.auth.uid &&
        request.resource.data.notificationId is string;
      allow delete: if belongsToAcademy(academyId) && resource.data.userId == request.auth.uid;
    }

    match /academies/{academyId}/{collectionName}/{document=**} {
      allow read: if isDeveloper() || isAdmin(academyId);
      // Do not override the stricter rules above with a recursive write grant.
      allow write: if isAdmin(academyId) && collectionName in [
        'anamneses', 'financialCategories', 'financialExpenses', 'financialSales',
        'stockCategories', 'stockItems', 'stockMovements'
      ];
    }

    match /auditLogs/{logId} {
      allow read: if isDeveloper() || (resource.data.academyId is string && isAdmin(resource.data.academyId));
      // Escritas passam pela Cloud Function, que deriva ator, papel e horário.
      allow create, update, delete: if false;
    }
  }
}
