rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function membership(academyId) {
      return get(/databases/$(database)/documents/academies/$(academyId)/members/$(request.auth.uid));
    }

    function belongsToAcademy(academyId) {
      return signedIn() && membership(academyId).data.active == true;
    }

    function isAdmin(academyId) {
      return belongsToAcademy(academyId) && membership(academyId).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /academies/{academyId} {
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow read: if belongsToAcademy(academyId);
      allow update, delete: if isAdmin(academyId);
    }

    match /academies/{academyId}/members/{memberId} {
      allow read: if signedIn() && (memberId == request.auth.uid || belongsToAcademy(academyId));
      allow create: if signedIn() && (
        (memberId == request.auth.uid &&
          request.resource.data.role == 'admin' &&
          request.resource.data.active == true &&
          getAfter(/databases/$(database)/documents/academies/$(academyId)).data.ownerId == request.auth.uid) ||
        isAdmin(academyId)
      );
      allow update, delete: if isAdmin(academyId);
    }

    match /academies/{academyId}/students/{studentId} {
      allow read: if belongsToAcademy(academyId);
      allow create, update: if isAdmin(academyId) || membership(academyId).data.role == 'teacher';
      allow delete: if isAdmin(academyId);
    }

    match /academies/{academyId}/{document=**} {
      allow read: if belongsToAcademy(academyId);
      allow write: if isAdmin(academyId);
    }
  }
}
