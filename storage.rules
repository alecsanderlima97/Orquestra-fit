rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function member(academyId) {
      return firestore.get(/databases/(default)/documents/academies/$(academyId)/members/$(request.auth.uid));
    }

    function academyOwner(academyId) {
      return signedIn()
        && firestore.get(/databases/(default)/documents/academies/$(academyId)).data.ownerId == request.auth.uid;
    }

    function isManager(academyId) {
      return signedIn()
        && member(academyId).data.active == true
        && member(academyId).data.role == 'admin';
    }

    function canManageExerciseMedia(academyId) {
      return academyOwner(academyId) ||
        (signedIn()
          && member(academyId).data.active == true
          && (member(academyId).data.role == 'admin' || member(academyId).data.role == 'teacher'));
    }

    function isPlatformDeveloper() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.accountType == 'developer';
    }

    match /gif-library/{allPaths=**} {
      allow read: if signedIn();
      allow write: if isPlatformDeveloper()
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'image/gif';
    }

    match /academies/{academyId}/finance/{allPaths=**} {
      allow read, delete: if isManager(academyId);
      allow create, update: if isManager(academyId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/(jpeg|png|webp)');
    }

    match /academies/{academyId}/exercise-media/{allPaths=**} {
      allow read: if signedIn() && member(academyId).data.active == true;
      allow delete: if canManageExerciseMedia(academyId);
      allow create, update: if canManageExerciseMedia(academyId)
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'image/gif';
    }
  }
}
